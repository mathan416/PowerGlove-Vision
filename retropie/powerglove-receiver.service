# Change log:
#   2026-09-02 - Added to PowerGlove Vision.
#   2026-09-03 - Standardized source documentation and maintenance metadata.
# Full history: docs/CHANGELOG.md and Git history.

[Unit]
Description=PowerGlove Vision virtual gamepad receiver
Wants=network-online.target
After=network-online.target
ConditionFileNotEmpty=/etc/powerglove/token

[Service]
Type=simple
User=root
RuntimeDirectory=powerglove
RuntimeDirectoryMode=0755
ExecStart=/opt/powerglove/bin/powerglove-receiver --listen 0.0.0.0 --token-file /etc/powerglove/token
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
